{
  "enabled": true,
  "name": "Commit Code Review",
  "description": "Automatically reviews newly committed code and creates a dated summary file in the committed files directory",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      ".git/COMMIT_EDITMSG",
      ".git/logs/HEAD"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new commit has been made. Please review the committed code changes and create a comprehensive code review summary. Save this review in a file named \"CommittedSummary-[current date in DD/MM/YYYY format].md\" in the same directory as the committed files. The review should include: 1) Summary of changes made, 2) Code quality assessment, 3) Potential issues or improvements, 4) Overall impact of the changes."
  }
}