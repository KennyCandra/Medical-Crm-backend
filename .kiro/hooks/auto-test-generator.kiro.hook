{
  "enabled": true,
  "name": "Auto Test Generator",
  "description": "Automatically creates comprehensive test files in src/test directory when you specify the file you need using jest library, with the naming convention of original filename + test.ts",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "src/**/*.ts",
      "src/**/*.js",
      "*.ts",
      "*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "The user has specified they need a test file created. Please create a comprehensive Jest test file for the specified file. The test file should be placed in the src/test directory with the naming convention of [original-filename].test.ts. Include thorough test cases covering all functions, methods, edge cases, error handling, and mock any dependencies as needed. Use Jest best practices and ensure good test coverage."
  }
}